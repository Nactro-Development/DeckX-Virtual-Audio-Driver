<Project>
  <PropertyGroup>
    <!-- Find WDK root on runner or local system -->
    <_WDKRoot Condition="'$(_WDKRoot)' == '' and Exists('C:\Program Files (x86)\Windows Kits\10')">C:\Program Files (x86)\Windows Kits\10</_WDKRoot>
    <_WDKRoot Condition="'$(_WDKRoot)' == '' and Exists('D:\New folder (2)')">D:\New folder (2)</_WDKRoot>
    
    <!-- Auto-detect latest WDK version installed -->
    <_WDKVersion Condition="'$(_WDKVersion)' == '' and Exists('$(_WDKRoot)\Include\10.0.26100.0\km')">10.0.26100.0</_WDKVersion>
    <_WDKVersion Condition="'$(_WDKVersion)' == '' and Exists('$(_WDKRoot)\Include\10.0.22621.0\km')">10.0.22621.0</_WDKVersion>
    <_WDKVersion Condition="'$(_WDKVersion)' == '' and Exists('$(_WDKRoot)\Include\10.0.22000.0\km')">10.0.22000.0</_WDKVersion>
    <_WDKVersion Condition="'$(_WDKVersion)' == '' and Exists('$(_WDKRoot)\Include\10.0.28000.0\km')">10.0.28000.0</_WDKVersion>

    <!-- Disable problematic InfVerif and ApiValidator targets in CI builds -->
    <UseInfVerifierEx>false</UseInfVerifierEx>
    <ValidateDrivers>false</ValidateDrivers>
    <InfVerif_Enable>false</InfVerif_Enable>
    <ApiValidator_Enable>false</ApiValidator_Enable>
    <DisableVerification>true</DisableVerification>
    <SignMode>Off</SignMode>

    <!-- Populate DDK_INC_PATH with kernel-mode and KMDF include directories -->
    <DDK_INC_PATH Condition="'$(_WDKVersion)' != ''">$(_WDKRoot)\Include\$(_WDKVersion)\km;$(_WDKRoot)\Include\$(_WDKVersion)\km\crt;$(_WDKRoot)\Include\$(_WDKVersion)\shared;$(_WDKRoot)\Include\wdf\kmdf\1.15;$(_WDKRoot)\Include\wdf\kmdf\1.25;$(_WDKRoot)\Include\wdf\kmdf\1.31;$(_WDKRoot)\Include\wdf\kmdf\1.33</DDK_INC_PATH>
    
    <!-- Populate DDK_LIB_PATH with kernel-mode lib directory -->
    <DDK_LIB_PATH Condition="'$(_WDKVersion)' != ''">$(_WDKRoot)\Lib\$(_WDKVersion)\km\$(Platform)</DDK_LIB_PATH>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(DDK_INC_PATH)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories Condition="'$(_WDKVersion)' != ''">%(AdditionalLibraryDirectories);$(DDK_LIB_PATH);$(_WDKRoot)\Lib\wdf\kmdf\$(Platform)\1.15;$(_WDKRoot)\Lib\wdf\kmdf\$(Platform)\1.25;$(_WDKRoot)\Lib\wdf\kmdf\$(Platform)\1.31;$(_WDKRoot)\Lib\wdf\kmdf\$(Platform)\1.33</AdditionalLibraryDirectories>
      <AdditionalDependencies>%(AdditionalDependencies);WdfDriverEntry.lib;WdfLdr.lib</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
